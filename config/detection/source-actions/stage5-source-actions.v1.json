        { "table": "flujo_materiales_detalles", "fields": ["id_articulo", "nombre_articulo", "id_unidad_uso", "cantidad_entransito_uso", "id_unidad_inventario", "cantidad_entransito_inventario", "costo_promedio", "id_articulo_serial", "id_lote", "id_almacen_origen", "id_almacen_destino", "id_ubicacion_almacen_origen", "id_ubicacion_almacen_destino", "observacion", "cantidad_recibida_uso", "cantidad_recibida_inventario", "id_usuario_creador", "fecha_creacion", "id_orden_trabajo", "cantidad_inicial_inventario", "cantidad_inicial_uso", "id_orden_trabajo_material", "moneda", "estado", "id_padre", "confirmar_peso"] }
