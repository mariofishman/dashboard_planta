      "postconditions": ["OT is closed and consumption rows are unchanged"],
      "rejects": ["invented consumption", "closed OT reactivation"]
    },
    {
      "id": "a03.cancel_work_order",
      "ruleCode": "A03",
      "naturalKey": "workOrderId",
      "invocation": { "operation": "sourceAction", "argument": "cancel_work_order" },
