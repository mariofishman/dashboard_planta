      "ruleCode": "A05",
      "naturalKey": "articleSerialId",
      "invocation": { "operation": "sourceAction", "argument": "close_work_order" },
      "mutations": [{ "table": "ordenes_trabajo", "fields": ["fecha_fin_ejecucion", "fecha_actualizacion"] }],
      "preconditions": ["reel retains its source OT relationship"],
