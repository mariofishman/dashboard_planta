      "ruleCode": "A02",
      "naturalKey": "materialFlowDetailId",
      "invocation": { "operation": "sourceAction", "argument": "reject" },
      "mutations": [
        { "table": "flujo_materiales_detalles", "fields": ["estado", "fecha_recepcion", "fecha_actualizacion"] },
