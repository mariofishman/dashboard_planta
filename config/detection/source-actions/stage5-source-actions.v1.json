      "preconditions": ["OT is open and not already cancelled"],
      "postconditions": ["OT is cancelled and consumption rows are unchanged"],
      "rejects": ["invented consumption", "cancelled OT reactivation"]
    },
    {
      "id": "a05.declare_produced_reel",
      "ruleCode": "A05",
      "naturalKey": "articleSerialId",
      "invocation": { "operation": "sourceAction", "argument": "declare_produced_reel" },
      "mutations": [{ "table": "articulo_serial", "fields": ["tipo", "estado", "fecha_creacion", "fecha_actualizacion"] }],
